{
  "name": "drift",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "DriftStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DriftStore"] }],
  "triggers": { "crons": ["* * * * *"] },
}
